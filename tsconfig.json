{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src/host",
    "outDir": "lib",
    "declarationDir": "lib/types"
  },
  "include": ["src/host/**/*.ts"],
  "exclude": ["src/client", "lib", "node_modules"]
}
